{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": true,
    "isolatedModules": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "types": ["jest", "node"]
  },
  "exclude": [
    "node_modules",
    "**/*.test.ts"
  ]
}
